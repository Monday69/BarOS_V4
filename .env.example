# Copier ce fichier en .env puis renseigner les valeurs.

# Secret d'administration (obligatoire) : chaîne aléatoire longue
BAROS_ADMIN_SECRET=change-moi

# Stripe (mode test suffisant) : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=http://localhost:5173

# Notifications push (optionnel) : générer avec `vapid --gen`
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=

# CORS (optionnel) : origines autorisées, séparées par des virgules
CORS_ORIGINS=http://localhost:5173
